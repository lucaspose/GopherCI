DATABASE_URL=postgres://goci:goci@localhost:5432/goci?sslmode=disable

# Auth
JWT_SECRET=change_me
JWT_EXPIRY=15
JWT_REFRESH_EXPIRY=10080

# 32-byte key used to encrypt SSH keys (AES-256-GCM)
ENCRYPTION_KEY=change_me_32_bytes_key_000000000

# GitHub OAuth app
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# Optional
ARTIFACTS_DIR=artifacts
LOG_LEVEL=INFO
LOG_SAMPLE_SUCCESS_EVERY=20
